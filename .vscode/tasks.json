{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build SOJ",
      "type": "shell",
      "command": "${workspaceFolder}\\build.bat",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Run SOJ",
      "type": "shell",
      "command": "${workspaceFolder}\\run.bat",
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "Build SOJ",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "clear": false
      }
    }
  ]
}
